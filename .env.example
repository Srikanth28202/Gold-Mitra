# ──────────────────────────────────────────────────────────
# Gold Mitra — Server configuration
# Copy to `.env` for local development.
# On Vercel, add these in Project → Settings → Environment Variables.
# ──────────────────────────────────────────────────────────

# Environment: development | production
NODE_ENV=development
PORT=3000

# ── MongoDB Atlas (REQUIRED) ──────────────────────────────
# Connection string from Atlas: Database → Connect → Drivers.
# The database name ("gold-mithra") is appended automatically here.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/gold-mithra?retryWrites=true&w=majority

# ── Sessions (REQUIRED in production) ─────────────────────
# Long random string (≥24 chars). Used to sign session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-secret
# Session lifetime in milliseconds (default 1 day).
SESSION_MAX_AGE_MS=86400000

# ── Bootstrap admin (OPTIONAL, RECOMMENDED in production) ─
# On first run with an empty database the app creates ONE admin from
# these values. In production the default password is never used — set
# a strong ADMIN_PASSWORD here or create staff another way.
ADMIN_NAME=Gold Mitra Admin
ADMIN_EMAIL=admin@goldmitra.com
ADMIN_PASSWORD=Change-Me-Now-Use-A-Strong-One